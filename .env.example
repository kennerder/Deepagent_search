# ========================================
# DeepAgents Search 环境变量配置
# 复制此文件为 .env 并填入你的真实值
# ========================================

# LLM 配置 (兼容 OpenAI API 格式)
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your_api_key_here
LLM_QWEN2.5=qwen2.5-14b-instruct
LLM_QWEN3=qwen3-32b
LLM_QWEN_MAX=qwen-max

# Tavily 网络搜索
TAVILY_API_KEY=your_tavily_api_key_here

# MySQL 数据库
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=pharma_db
MYSQL_HOST=localhost
MYSQL_PORT=3306

# RAGFlow (已弃用，保留兼容)
# RAGFLOW_API_URL=http://129.211.218.165
# RAGFLOW_API_KEY=your_ragflow_key

# 服务安全 (可选，不设则维持本地开发默认行为)
# API_TOKEN=设置后 REST 需带 X-API-Token 请求头，WebSocket 需带 ?token=
# CORS_ORIGINS=*            # 需要跨域携带凭证时改成具体来源，逗号分隔
# ALLOW_WRITE_SQL=false     # 设为 true 时数据库工具才允许非只读 SQL
